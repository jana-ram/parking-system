PORT=7000
NODE_ENV=production

# Using the real MongoDB 8.2 service already installed and running on this
# machine (Windows service "MongoDB", already configured with
# replication.replSetName=rs0 and initiated) rather than mongodb-memory-server —
# so data persists across backend restarts.
# MONGO_URI=mongodb://localhost:27017/smart_parking?replicaSet=rs0
MONGO_URI=mongodb://admin:password123@localhost:27017/smart_parking?authSource=admin

# JWT — staff/admin session tokens
JWT_SECRET=change_this_to_a_long_random_secret_key
JWT_EXPIRE=12h
JWT_REFRESH_EXPIRE=30d

# Platform admin auth is deliberately a SEPARATE secret from the tenant JWT_SECRET
# above (see §1.7 — platform and tenant auth must never share a signing key).
PLATFORM_JWT_SECRET=change_this_to_a_different_long_random_secret_key

# Device secret encryption (§N) — the raw per-device HMAC secret is encrypted at
# rest with this key (NOT bcrypt-hashed, since HMAC verification needs the
# plaintext back). 32-byte hex key for AES-256-GCM.
DEVICE_SECRET_ENC_KEY=

# CORS — owner-web origin(s), comma-separated
ALLOWED_ORIGINS=http://localhost:5173

# Default super-admin seeded on first boot if no PlatformAdmin exists. The
# ChangeMe@123 default only applies outside production — server.js's
# seedPlatformAdmin() refuses to seed at all when NODE_ENV=production and
# either of these is unset, rather than silently create a guessable-password
# admin account.
PLATFORM_ADMIN_EMAIL=owner@smartparkingos.com
PLATFORM_ADMIN_PASSWORD=ChangeMe@123
